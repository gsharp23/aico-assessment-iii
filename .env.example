# Copy to .env and fill in. .env is gitignored - no secret ever enters the repo.
# In CI/CD these same values come from GitHub Secrets and AWS Secrets Manager.

# --- Database ---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ragdb

# --- AWS Bedrock ---
AWS_REGION=us-east-1
CHAT_MODEL_ID=us.amazon.nova-lite-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Local development only. On EC2 the instance's IAM role provides credentials
# and these stay empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Semantic memory ---
# Leave blank to run without Mem0; the app degrades gracefully.
MEM0_API_KEY=

LOG_LEVEL=INFO
